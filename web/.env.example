# dpr-livestreaming — copy to .env.local. Never commit real values.
PORT=5173
NEXT_PUBLIC_APP_ORIGIN=http://localhost:5173

# ── Agora (RTC video + RTM chat/reactions) ─────────────────────────────
# Dev/test project 5febe019… (has a certificate); production 677d4dd9… (Secrets Manager auction-stream/<env>/agora).
NEXT_PUBLIC_AGORA_APP_ID=
# Server only — never NEXT_PUBLIC.
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=3600
# One stream at a time; `Live` is also auction-stream's default channel.
NEXT_PUBLIC_LIVESTREAM_CHANNEL=Live
# A camera without a heartbeat for this long is off air.
STREAM_HEARTBEAT_TTL_MS=30000

# ── Host login: Keycloak (same realm/client as auction-stream /host) ──
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.dev.dupontregistry.com
NEXT_PUBLIC_KEYCLOAK_REALM=mrkt
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=auction-stream
HOST_ALLOWED_EMAIL_DOMAINS=dupontregistry.com,dupontregistrygroup.com
# true = real Keycloak login. false = dev bypass (any host name, no SSO) — ignored when NODE_ENV=production.
NEXT_PUBLIC_HOST_AUTH=true

# ── Viewers: tickets signed by each host platform's server ─────────────
# ≥ 32 chars, shared with the platforms (drlive-frontend: same name). Per platform if needed:
# LIVESTREAM_VIEWER_TICKET_SECRET_GARAGE=…  (matches tickets with iss=garage)
LIVESTREAM_VIEWER_TICKET_SECRET=
# Sites allowed to frame /embed/live and call /api/stream/status (CORS). `*` = subdomains / any port.
LIVESTREAM_ALLOWED_PARENT_ORIGINS=https://dupontregistry.com,https://*.dupontregistry.com,https://*.dra.tools,http://localhost:*,http://127.0.0.1:*

# Where the stream record + chat snapshot are kept (single instance). Default ./.data
# LIVESTREAM_DATA_DIR=
